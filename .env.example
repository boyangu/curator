# Copy to .env (git-ignored) at the repo root. Placeholders only — never
# commit a real value. Without any of these Curator runs local-only: no
# streaming sources, no cloud sync, no Google Drive backup (each feature
# shows "not configured" in Settings).
#
# How they reach the app: `pnpm dev` and `pnpm --filter @curator/desktop
# build|package*` read this file (then apps/desktop/.env, then the shell)
# and bake the values into the main bundle (apps/desktop/electron.vite.config.ts).
# A packaged app never reads the end user's shell. A build refuses to run
# with any of the credentials / project ids unset unless
# CURATOR_ALLOW_UNCONFIGURED_BUILD=1 is set, so a release is never silently
# local-only. CURATOR_CLOUD_API_URL alone only warns (empty = sync off).
#
# Tests and the headless CLI read the real environment; nothing set is the
# default and every suite passes that way.

# Spotify: Developer Dashboard (developer.spotify.com/dashboard) → your app →
# Client ID. PKCE flow, no secret. Register the redirect URI
# http://127.0.0.1:51737/auth/spotify/callback on the app.
CURATOR_SPOTIFY_CLIENT_ID=<spotify-client-id>

# Tidal: Developer Portal (developer.tidal.com/dashboard) → your app →
# Client ID + Client Secret. Register the same loopback redirect URI there.
CURATOR_TIDAL_CLIENT_ID=<tidal-client-id>
CURATOR_TIDAL_CLIENT_SECRET=<tidal-client-secret>

# Google Drive backup: Google Cloud console → APIs & Services → Credentials
# → OAuth client ID of type "Desktop app" (Drive API enabled, consent screen
# "In production"; the drive.file scope needs no verification). Google
# documents a Desktop client's secret as not secret, but the token endpoint
# demands it.
CURATOR_GOOGLE_CLIENT_ID=<number>-<hash>.apps.googleusercontent.com
CURATOR_GOOGLE_CLIENT_SECRET=<google-client-secret>

# Curator account + cloud sync: Supabase project → Project Settings → API →
# Project URL and the publishable (anon) key. Both unset ⇒ no sign-in.
CURATOR_SUPABASE_URL=https://<project-ref>.supabase.co
CURATOR_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# The deployed cloud API (apps/cloud), e.g. https://<fly-app>.fly.dev — no
# trailing slash, no /trpc. Empty ⇒ sign-in works but library sync is off
# (a warning at build time, not a failure: the API deploys later).
CURATOR_CLOUD_API_URL=

# Set to 1 to build/package a deliberately local-only app with the
# credentials above unset (CI, a contributor without vendor apps).
#CURATOR_ALLOW_UNCONFIGURED_BUILD=1

# Maintainer only: the Supabase transaction pooler host (Connect -> Transaction pooler,
# the part after @), used by `pnpm cloud:rotate-db-password`.
CURATOR_DB_POOLER_HOST=aws-0-<region>.pooler.supabase.com
