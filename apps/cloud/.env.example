# Copy to .env (git-ignored) for local runs; production sets these as Fly secrets.
# Placeholders only. Never commit a real value.

# Postgres connection for the API. In production this is the least-privilege
# `curator_api` login role from sql/roles.sql, never `postgres` or the
# service role. Migrations (`pnpm db:migrate`) run with the owner connection
# instead; pass that one inline for the single command.
DATABASE_URL=postgres://curator_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The Supabase project URL. Tokens are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json; no JWT secret is needed.
SUPABASE_URL=https://<project-ref>.supabase.co

PORT=8080

# Catalogue units this server accepts (src/catalogue/policy.ts); unset or
# "off" = no catalogue. Production sets it in fly.toml [env], not as a secret.
CURATOR_CATALOGUE=rhythm,key,structure,advanced,fingerprint,peaks:lo

# 1 = refuse sync.pull / sync.bootstrap that name no device (update_required).
# Leave unset until every desktop speaks 'device_reads' (README "Revoking a
# device"). Production sets it in fly.toml [env], not as a secret.
# CURATOR_REQUIRE_DEVICE_ID=1

# The Spotify gateway (README "Spotify gateway"). On only with both of the first
# two; with either unset the spotify.* procedures answer spotify_not_connected
# and health leaves 'spotify_gateway' out. Production: Fly secrets set by
# `pnpm cloud:set-token-key`, never typed by hand. A local run can make a key
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CURATOR_SPOTIFY_CLIENT_ID=<the Spotify app's client id, 32 hex characters>
# CURATOR_TOKEN_KEY=<32 random bytes, base64>
# The key before a rotation, while sealed grants move off it.
# CURATOR_TOKEN_KEY_PREV=<32 random bytes, base64>
