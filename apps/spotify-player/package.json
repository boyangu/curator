{
  "name": "@curator/spotify-player",
  "productName": "curator-spotify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder --dir",
    "sign": "python -m castlabs_evs.vmp sign-pkg dist/win-unpacked",
    "package:signed": "pnpm package && pnpm sign"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "https://github.com/castlabs/electron-releases#v38.8.6+wvcus",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.4"
  }
}
