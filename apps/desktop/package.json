{
  "name": "@curator/desktop",
  "productName": "Curator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "predev": "node scripts/rebuild-sqlite.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/rebuild-sqlite.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit && node scripts/check-renderer-boundaries.mjs",
    "rebuild:electron": "node scripts/rebuild-sqlite.mjs",
    "cdp": "node scripts/cdp.mjs",
    "package": "electron-vite build && electron-builder --dir",
    "sign": "python -m castlabs_evs.vmp sign-pkg dist/win-unpacked",
    "package:signed": "pnpm package && pnpm sign",
    "start:packaged": "dist\\win-unpacked\\Curator.exe",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepackage": "node scripts/rebuild-sqlite.mjs && node ../../scripts/build-sidecars.mjs --ensure-dirs"
  },
  "dependencies": {
    "@curator/core": "workspace:*",
    "@curator/google-drive": "workspace:*",
    "@curator/protocol": "workspace:*",
    "@curator/shared": "workspace:*",
    "@curator/spotify": "workspace:*",
    "@curator/tidal": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/virtual-core": "^3.19.7",
    "@tidal-music/common": "^0.2.1",
    "@tidal-music/player": "^0.20.1",
    "@trpc/client": "^11",
    "@trpc/server": "^11",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.10.0",
    "electron": "https://github.com/castlabs/electron-releases#v38.8.6+wvcus",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^2.1.6"
  }
}
